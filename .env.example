# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
# Local SQLite default: sqlite:///mailshield.db
# PostgreSQL for production: postgresql://user:password@localhost:5432/mailshield
DATABASE_URL=sqlite:///mailshield.db

# Security & Upload Limits
MAX_CONTENT_LENGTH=16777216
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Optional Threat Intelligence API Keys (Core functionality works without them)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=
